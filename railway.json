{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "npx next start --port ${PORT:-3000} --hostname 0.0.0.0",
    "preDeployCommand": ["npx prisma migrate deploy && if [ \"${RUN_DB_SEED:-}\" = \"true\" ]; then npx prisma db seed; fi"],
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
