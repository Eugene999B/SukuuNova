# PostgreSQL connection used by the application and Prisma migrations.
DATABASE_URL=

# A separate disposable PostgreSQL database is strongly recommended for tests.
TEST_DATABASE_URL=

# Use independent, random values of at least 32 characters.
SCHOOL_AUTH_SECRET=
PLATFORM_AUTH_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required only when running the seed command. Never commit real values.
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Optional: both values must be supplied together to seed a platform admin.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_NAME=
