# PostgreSQL connection used by the application and Prisma migrations.
DATABASE_URL=

# Railway: normally reference the PostgreSQL service's DATABASE_URL from the SukuuNova service.
# Example: DATABASE_URL=${{Postgres.DATABASE_URL}}

# A separate disposable PostgreSQL database is strongly recommended for tests.
TEST_DATABASE_URL=

# Use independent, random values of at least 32 characters.
SCHOOL_AUTH_SECRET=
GUARDIAN_AUTH_SECRET=
QR_AUTH_SECRET=
PLATFORM_AUTH_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required only when running the seed command. Never commit real values.
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Optional: both values must be supplied together to seed a platform admin.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_NAME=

# SMS delivery provider. Keep empty until a provider is configured.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=

# Password-reset email delivery provider. Keep empty until a provider is configured.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
EMAIL_FROM=
# Local development only; must never be enabled in production.
ALLOW_DEV_TOKEN_ECHO=false

# AWS Rekognition managed face-vector collection (images are not persisted by SukuuNova).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_EMBEDDING_ENCRYPTION_KEY=

# Twilio WhatsApp Business API. Content SIDs are configured per school in SukuuNova.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Phase 4 AI + controlled WhatsApp parent assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
WHATSAPP_WEBHOOK_SECRET=
# Native Meta webhook support: app secret signs POSTs; verify token handles GET subscription challenge.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# External scheduler cadence used for the risk-scan job.
RISK_SCAN_INTERVAL_MS=21600000
# Shared secret required by POST /api/cron/risk-scan.
RISK_SCAN_CRON_SECRET=
