generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformAdmin {
  id                  String                       @id @default(cuid())
  name                String
  email               String                       @unique
  passwordHash        String
  role                String
  status              String                       @default("active")
  createdAt           DateTime                     @default(now())
  passwordResetTokens PlatformPasswordResetToken[]
}

model AuditLogPlatform {
  id             String   @id @default(cuid())
  actorId        String
  action         String
  targetSchoolId String?
  targetEntity   String?
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([targetSchoolId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String   @unique
  price        Decimal
  featureFlags Json
  schools      School[]
}

model SchoolLoginDirectory {
  schoolId   String   @id
  uniqueCode String   @unique
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LoginRateLimit {
  identityHash    String    @id
  attemptCount    Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}

model PlatformPasswordResetToken {
  id        String        @id @default(cuid())
  adminId   String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model School {
  id                  String   @id @default(cuid())
  uniqueCode          String   @unique
  name                String
  logoUrl             String?
  brandColors         Json?
  subscriptionPlanId  String?
  status              String   @default("active")
  createdAt           DateTime @default(now())
  subscriptionPlan    SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  settings            SchoolSettings?
  users               User[]
  roles               Role[]
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  passwordResetTokens SchoolPasswordResetToken[]
  auditLogs           AuditLogSchool[]
  academicYears       AcademicYear[]
  calendarEvents      CalendarEvent[]
  terms               Term[]
  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  classes             Class[]
  subjects            Subject[]
  teacherAssignments  ClassSubjectTeacher[]
  attendanceEvents    AttendanceEvent[]
  assessments         Assessment[]
  scores              Score[]
  reportCards         ReportCard[]
  feeItems            FeeItem[]
  invoices            Invoice[]
  invoiceLines        InvoiceLine[]
  payments            Payment[]
  paymentReversals    PaymentReversal[]
  messages                 Message[]
  timetableSlots           TimetableSlot[]
  substituteAssignments    SubstituteAssignment[]
  faceEnrollments          FaceEnrollment[]
  faceMatchReviews         FaceMatchReview[]
}

model SchoolSettings {
  id                        String  @id @default(cuid())
  schoolId                  String  @unique
  academicYearLabel         String?
  currentTermLabel          String?
  attendanceEnabled         Boolean @default(true)
  parentMessagingEnabled    Boolean @default(true)
  financeEnabled            Boolean @default(true)
  payrollEnabled            Boolean @default(true)
  transportEnabled          Boolean @default(true)
  feedingEnabled            Boolean @default(true)
  libraryEnabled            Boolean @default(true)
  riskEnabled               Boolean @default(true)
  assessmentEnabled         Boolean @default(true)
  reportCardsEnabled        Boolean @default(true)
  whatsappEnabled           Boolean @default(false)
  smsEnabled                Boolean @default(false)
  timezone                  String  @default("Africa/Accra")
  weekStartsOn              String  @default("Monday")
  currency                  String  @default("GHS")
  currencySymbol            String  @default("₵")
  lateThresholdMinutes      Int     @default(15)
  autoNotifyAbsence         Boolean @default(false)
  requireParentAck          Boolean @default(false)
  pickupVerificationEnabled Boolean @default(false)
  faceAttendanceEnabled     Boolean @default(false)
  faceConfidenceThreshold   Float   @default(90)
  visitorApprovalEnabled    Boolean @default(true)
  dailyDigestEnabled        Boolean @default(false)
  dailyDigestTime           String  @default("16:00")
  substituteLateMinutes     Int     @default(20)
  notificationChannels      Json?
  whatsappTemplateConfig    Json?
  reportCardWatermark       String?
  timetableConfig           Json?
  assessmentConfig          Json?
  reportCardConfig          Json?
  school                    School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
}

model User {
  id                  String   @id @default(cuid())
  schoolId            String
  name                String
  email               String?
  phone               String?
  profilePhotoData    String?  @db.Text
  passwordHash        String
  status              String   @default("active")
  createdAt           DateTime @default(now())
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  passwordResetTokens SchoolPasswordResetToken[]
  guardianProfiles    Guardian[] @relation("GuardianUser")
  classTeacherFor     Class[] @relation("ClassTeacher")
  subjectAssignments  ClassSubjectTeacher[] @relation("AssignedTeacher")
  staffAttendance     AttendanceEvent[] @relation("AttendanceStaff")
  attendanceRecorded  AttendanceEvent[] @relation("AttendanceRecorder")
  scoresEntered             Score[] @relation("ScoreEnteredBy")
  timetableSlots            TimetableSlot[] @relation("TimetableTeacher")
  substituteAssignments     SubstituteAssignment[] @relation("SubstituteTeacher")
  substitutesAssigned       SubstituteAssignment[] @relation("SubstituteAssigner")
  faceEnrollments           FaceEnrollment[] @relation("FaceStaff")
  faceMatchCandidates       FaceMatchReview[] @relation("FaceReviewStaff")
  faceReviewsCompleted      FaceMatchReview[] @relation("FaceReviewedBy")
  pickupRequestsCreated     PickupApprovalRequest[] @relation("PickupRequestedBy")
  pickupRequestsApproved    PickupApprovalRequest[] @relation("PickupApprovedBy")
  pickupEventsApproved      PickupEvent[] @relation("PickupEventApprovedBy")
  salaryStructures          SalaryStructure[]
  payslips                  Payslip[]
  hostedVisitors            VisitorLog[] @relation("VisitorHost")

  @@unique([id, schoolId])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId])
}

model Role {
  id              String  @id @default(cuid())
  schoolId        String
  name            String
  key             String?
  isSystem        Boolean @default(false)
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  @@index([schoolId])
}

model Permission {
  id                  String @id @default(cuid())
  key                 String @unique
  description         String?
  rolePermissions     RolePermission[]
  permissionOverrides UserPermissionOverride[]
}

model RolePermission {
  schoolId     String
  roleId       String
  permissionId String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([schoolId])
}
